# Copy to .env and fill in to enable live NEAR testnet anchoring.
# Without these, AgentGuard runs fully in local mode and entries are marked
# "local only" — nothing is faked.
NEAR_TESTNET_ACCOUNT_ID=your-account.testnet
# Recommended: point this at a FUNCTION-CALL key credential file (see
# scripts/setup-fc-key.mjs) scoped to log_decision on the log contract —
# the app then never holds a full-access key. The operator's full-access
# credential file is only used by the one-off setup/deploy scripts.
NEAR_TESTNET_CREDENTIALS=/path/to/.near-credentials/testnet/your-account.testnet-fc.json
# The deployed AgentGuard log contract (see contract/ + scripts/deploy-contract.mjs).
# If unset, anchoring falls back to the NEAR Social testnet contract
# v1.social08.testnet.
AGENTGUARD_CONTRACT_ID=log.your-account.testnet
# Optional: NEAR AI Cloud inference for parsing payment instructions.
# Without it, a built-in deterministic parser is used.
# NEAR_AI_API_KEY=
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
# PORT=8787
