# Copy to .env and fill in to enable live NEAR testnet anchoring.
# Without these, AgentGuard runs fully in local mode and entries are marked
# "local only" — nothing is faked.
NEAR_TESTNET_ACCOUNT_ID=your-account.testnet
NEAR_TESTNET_CREDENTIALS=/path/to/.near-credentials/testnet/your-account.testnet.json
# Optional: a deployed AgentGuard log contract (see contract/). If unset,
# anchoring uses the NEAR Social testnet contract v1.social08.testnet.
# AGENTGUARD_CONTRACT_ID=agentguard.your-account.testnet
# Optional: NEAR AI Cloud inference for parsing payment instructions.
# Without it, a built-in deterministic parser is used.
# NEAR_AI_API_KEY=
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
# PORT=8787
